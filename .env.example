# Copia este archivo como .env y ajusta los valores. El .env no se sube al repositorio.
# Las variables EXPO_PUBLIC_* quedan dentro de la app y cualquiera puede leerlas:
# nunca pongas contraseñas, tokens ni llaves aquí.

# URL base del backend de NU-B Studio (corre en tu laptop, puerto 4000).
# Desde el celular no sirve localhost: usa la IP de tu laptop en la red Wi-Fi
# (en fish: ip -4 addr | grep inet). Celular y laptop deben estar en la misma red.
EXPO_PUBLIC_API_URL=http://192.168.X.X:4000

# URL de la plataforma web, a donde se redirige para pagar.
EXPO_PUBLIC_WEB_URL=http://192.168.X.X:5173
