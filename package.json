{
  "name": "nub-temp",
  "version": "1.0.0",
  "packageManager": "pnpm@11.3.0",
  "main": "index.js",
  "dependencies": {
    "@expo-google-fonts/outfit": "^0.4.3",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.19.2",
    "expo": "~57.0.30",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.55.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "expo export --platform android",
    "test": "jest",
    "test:estatico": "pnpm lint && pnpm format:check",
    "test:doctor": "pnpm dlx expo-doctor",
    "test:seguridad": "pnpm audit --prod --audit-level high",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand",
    "test:api": "pnpm dlx newman@6 run tests/api/nub-studio.postman_collection.json",
    "test:carga": "k6 run tests/performance/carga.js",
    "test:estres": "k6 run tests/performance/estres.js",
    "test:e2e": "maestro test tests/e2e",
    "test:ci": "jest --ci --coverage"
  },
  "private": true,
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "13.3.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.8",
    "react-test-renderer": "19.2.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/tests/setup/jest.setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/utils/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 80,
        "branches": 70,
        "statements": 80
      }
    }
  }
}
