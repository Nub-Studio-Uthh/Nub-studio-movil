{
  "info": {
    "name": "NUB Studio - API (pruebas de integración)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Catálogo - listar obras",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/obras?limit=5" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "pm.test('Regresa una lista', () => pm.expect(pm.response.json().data).to.be.an('array'));",
              "pm.test('Responde en menos de 3 s', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
            ]
          }
        }
      ]
    },
    {
      "name": "Categorías",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/categorias" },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('Responde 200', () => pm.response.to.have.status(200));"] }
        }
      ]
    },
    {
      "name": "Artistas",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/artistas" },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('Responde 200', () => pm.response.to.have.status(200));"] }
        }
      ]
    },
    {
      "name": "Colecciones",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/colecciones" },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('Responde 200', () => pm.response.to.have.status(200));"] }
        }
      ]
    },
    {
      "name": "Blog - publicaciones",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/blog/posts" },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('Responde 200', () => pm.response.to.have.status(200));"] }
        }
      ]
    },
    {
      "name": "Login - credenciales incorrectas",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"correo\":\"no-existe-ci@nubstudio.test\",\"contrasena\":\"incorrecta123\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('No permite entrar', () => pm.expect(pm.response.code).to.be.within(400, 499));"
            ]
          }
        }
      ]
    },
    {
      "name": "Carrito sin sesión",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/carrito" },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Pide autenticación', () => pm.expect([401, 403]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    }
  ]
}
